{
  "expo": {
    "name": "pateint-app",
    "slug": "pateint-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logos/app-logo.png",
    "scheme": "pateintapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/logos/app-logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#DDF4C7",
        "foregroundImage": "./assets/logos/app-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kiras106.pateintapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/logos/app-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#DDF4C7",
          "image": "./assets/logos/splash-logo.png",
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "059faab5-fa4b-439c-9ed8-04b3d0f28b22"
      }
    }
  }
}
